---
import { Font } from 'astro:assets'

type SEO = {
  title?: string
  description?: string
  image?: URL
  imageAlt?: string
}
interface Props {
  seo?: SEO
}

import '@/styles/global.scss'

const canonicalURL = new URL(Astro.url.pathname, Astro.site)

const locale = Astro.currentLocale
const openGraphLocale = locale.replace('-', '_')

const defaultSiteImage = new URL('sharing-image.jpg', Astro.site)
const defaultSiteImageAlt =
  'A full cocktail glass with lemon garnish sitting on a dark wooden table with a cocktail spoon and lemon slices, in front of a dark wooden board background.'

const { seo = {} } = Astro.props
---

<!doctype html>
<html lang={locale ?? 'en-CA'}>
  <head>
    <meta charset='utf-8' />
    <meta name='viewport' content='width=device-width, initial-scale=1' />

    <title>{seo?.title}</title>
    {seo?.description && <meta name='description' content={seo?.description} />}

    <link rel='canonical' href={canonicalURL} />
    <link rel='sitemap' href='/sitemap-index.xml' />

    <meta property='og:title' content={seo?.title} />
    {
      seo?.description && (
        <meta property='og:description' content={seo?.description} />
      )
    }

    <meta property='og:locale' content={openGraphLocale ?? 'en_CA'} />
    <meta property='og:type' content='website' />
    <meta property='og:url' content={canonicalURL} />
    <meta property='og:image' content={seo?.image ?? defaultSiteImage} />
    <meta
      property='og:image:alt'
      content={seo?.imageAlt ?? defaultSiteImageAlt}
    />

    <meta name='twitter:card' content='summary_large_image' />
    <meta name='twitter:title' content={seo?.title} />
    {
      seo?.description && (
        <meta name='twitter:description' content={seo?.description} />
      )
    }
    <meta name='twitter:image' content={seo?.image ?? defaultSiteImage} />
    <meta
      name='twitter:image:alt'
      content={seo?.imageAlt ?? defaultSiteImageAlt}
    />

    <meta
      name='theme-color'
      media='(prefers-color-scheme: light)'
      content='#DEDEDE'
    />
    <meta
      name='theme-color'
      media='(prefers-color-scheme: dark)'
      content='#1C1C1B'
    />
    <meta name='color-scheme' content='dark light' />

    <link rel='icon' href='/favicon.ico' sizes='any' />
    <link rel='icon' href='/icon.svg' type='image/svg+xml' />
    <link rel='apple-touch-icon' href='/apple-touch-icon.png' />

    <link rel='manifest' href='/manifest.webmanifest' />

    <Font cssVariable='--primary-font' />
    <Font cssVariable='--secondary-font' />
  </head>
  <body class:list={'layout'}>
    <header class:list={'header'}>
      <h1 class:list={'text'}>
        #ldnont <br />
        Gin Club
        <span class:list={'icon'}>
          <svg
            xmlns='http://www.w3.org/2000/svg'
            viewBox='0 0 576 512'
            aria-hidden={true}
            focusable='false'
          >
            <path
              fill={'currentColor'}
              d='M432 240c53 0 96-43 96-96s-43-96-96-96c-35.5 0-66.6 19.3-83.2 48H296.2C316 40.1 369.3 0 432 0c79.5 0 144 64.5 144 144s-64.5 144-144 144c-27.7 0-53.5-7.8-75.5-21.3l35.4-35.4c12.2 5.6 25.8 8.7 40.1 8.7zM1.8 142.8C5.5 133.8 14.3 128 24 128H392c9.7 0 18.5 5.8 22.2 14.8s1.7 19.3-5.2 26.2l-177 177V464h64c13.3 0 24 10.7 24 24s-10.7 24-24 24H208 120c-13.3 0-24-10.7-24-24s10.7-24 24-24h64V345.9L7 169c-6.9-6.9-8.9-17.2-5.2-26.2z'
            ></path>
          </svg>
        </span>
      </h1>
    </header>
    <slot />
    <footer class:list={'footer'}>
      Made with
      <svg
        xmlns='http://www.w3.org/2000/svg'
        viewBox='0 0 512 512'
        aria-hidden={true}
        focusable='false'
      >
        <path
          fill={'currentColor'}
          d='M244 84L255.1 96L267.1 84.02C300.6 51.37 347 36.51 392.6 44.1C461.5 55.58 512 115.2 512 185.1V190.9C512 232.4 494.8 272.1 464.4 300.4L283.7 469.1C276.2 476.1 266.3 480 256 480C245.7 480 235.8 476.1 228.3 469.1L47.59 300.4C17.23 272.1 0 232.4 0 190.9V185.1C0 115.2 50.52 55.58 119.4 44.1C164.1 36.51 211.4 51.37 244 84C243.1 84 244 84.01 244 84L244 84zM255.1 163.9L210.1 117.1C188.4 96.28 157.6 86.4 127.3 91.44C81.55 99.07 48 138.7 48 185.1V190.9C48 219.1 59.71 246.1 80.34 265.3L256 429.3L431.7 265.3C452.3 246.1 464 219.1 464 190.9V185.1C464 138.7 430.4 99.07 384.7 91.44C354.4 86.4 323.6 96.28 301.9 117.1L255.1 163.9z'
        ></path>
      </svg>
      in London, Canada
    </footer>
  </body>
</html>
